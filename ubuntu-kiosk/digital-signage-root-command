#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
	echo "This helper must run through the installed sudo policy." >&2
	exit 1
fi

case "${1:-}" in
	reboot)
		systemctl reboot
		;;
	software-update)
		/usr/local/sbin/digital-signage-update --no-restart
		;;
	system-update)
		export DEBIAN_FRONTEND=noninteractive
		apt-get update
		apt-get -y upgrade
		;;
	*)
		echo "Unsupported privileged command." >&2
		exit 2
		;;
esac
