#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
	echo "This helper must run through the installed sudo policy." >&2
	exit 1
fi

case "${1:-}" in
	reboot)
		systemctl reboot
		;;
	software-update)
		if systemctl is-active --quiet digital-signage-ubuntu-update.service; then
			echo "A signage update is already running."
			exit 0
		fi
		systemctl reset-failed digital-signage-ubuntu-update.service >/dev/null 2>&1 || true
		systemctl start --no-block digital-signage-ubuntu-update.service
		echo "Signage update job started."
		;;
	system-update)
		export DEBIAN_FRONTEND=noninteractive
		apt-get update
		apt-get -y upgrade
		;;
	check)
		echo "Digital Signage privileged command access is ready."
		;;
	*)
		echo "Unsupported privileged command." >&2
		exit 2
		;;
esac
