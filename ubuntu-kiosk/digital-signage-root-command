#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
	echo "This helper must run through the installed sudo policy." >&2
	exit 1
fi

case "${1:-}" in
	reboot)
		systemctl reboot
		;;
	software-update)
		if systemctl is-active --quiet digital-signage-ubuntu-update.service; then
			echo "A signage update is already running."
			exit 0
		fi
		systemctl reset-failed digital-signage-ubuntu-update.service >/dev/null 2>&1 || true
		systemctl start --no-block digital-signage-ubuntu-update.service
		echo "Signage update job started."
		;;
	system-update)
		export DEBIAN_FRONTEND=noninteractive
		apt-get update
		apt-get -y upgrade
		;;
	diagnostic-update)
		echo "Update service"
		systemctl status digital-signage-ubuntu-update.service --no-pager --full || true
		echo
		echo "Recent update log"
		journalctl --unit digital-signage-ubuntu-update.service --lines 80 --no-pager || true
		;;
	diagnostic-controller)
		echo "Controller processes"
		pgrep -af '/digital-signage-ubuntu/ds_ubuntu_controller.py' || echo "Controller process not found"
		echo
		echo "Display manager"
		systemctl status gdm3 --no-pager --full || true
		;;
	diagnostic-network)
		echo "Addresses"
		ip -brief address || true
		echo
		echo "Routes"
		ip route || true
		;;
	diagnostic-system)
		echo "Uptime"
		uptime
		echo
		echo "Memory"
		free -h
		echo
		echo "Disk"
		df -h / /opt 2>/dev/null || df -h /
		;;
	check)
		echo "Digital Signage privileged command access is ready."
		;;
	*)
		echo "Unsupported privileged command." >&2
		exit 2
		;;
esac
