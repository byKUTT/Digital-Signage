[Unit]
Description=byKUTT Digital Signage Ubuntu multi-display controller
After=display-manager.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=12

[Service]
Type=simple
User=@@KIOSK_USER@@
Group=@@KIOSK_GROUP@@
Environment=DS_KIOSK_USER=@@KIOSK_USER@@
Environment=DISPLAY=:0
ExecStart=/usr/local/bin/ds-ubuntu-session-wait
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
PrivateTmp=false
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/etc/digital-signage-ubuntu

[Install]
WantedBy=graphical.target
